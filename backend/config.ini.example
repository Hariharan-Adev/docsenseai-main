; Copy this file to backend/config.ini on the server, then edit deployment values.
; Environment variables still override this file when both are set.

[app]
APP_ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:5173
API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
JWT_SECRET_KEY=change-me-locally
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_SALT=change-me-locally
METRICS_TOKEN=
METRICS_ALLOW_PRIVATE_NETWORKS=true

[llm]
LLM_PROVIDER=azure_openai
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_CALLS_PER_DAY=50
GROQ_DAILY_TOKEN_BUDGET=200000
GROQ_DAILY_COST_CAP_USD=5
GROQ_PROMPT_COST_PER_MILLION=0
GROQ_COMPLETION_COST_PER_MILLION=0
AZURE_OPENAI_ENDPOINT=https://laserbeam-ai.openai.azure.com/
AZURE_OPENAI_API_KEY=PASTE_KEY_1_HERE
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_RAG_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_UTILITY_DEPLOYMENT=gpt-5.4-mini
ENABLE_IMAGE_VISION=true

[smtp]
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=PASTE_BREVO_SMTP_LOGIN_HERE
SMTP_PASSWORD=PASTE_BREVO_SMTP_KEY_HERE
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Docsense AI
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

[uploads]
MAX_FOLDER_FILES=25
MAX_FILE_SIZE_MB=25
MAX_VIDEO_FILE_SIZE_MB=25
MAX_FOLDER_TOTAL_SIZE_MB=200
MAX_CONCURRENT_FILE_PROCESSING=3
MAX_ZIP_UPLOAD_MB=50
MAX_ZIP_EXTRACTED_MB=250
MAX_ZIP_FILES=100
MAX_ZIP_COMPRESSION_RATIO=100
MAX_OFFICE_ARCHIVE_ENTRIES=10000
MAX_OFFICE_UNCOMPRESSED_MB=250
MAX_OFFICE_COMPRESSION_RATIO=100
MAX_PDF_PAGES=1000
MAX_POWERPOINT_SLIDES=1000
MAX_WORKBOOK_SHEETS=250
MAX_WORKBOOK_ROWS=200000
PARSER_TIMEOUT_SECONDS=120
TESSERACT_CMD=
OCR_REQUIRED_LANGUAGES=eng
INCLUDE_HIDDEN_WORKSHEETS=true
INCLUDE_VERY_HIDDEN_WORKSHEETS=false
EMBEDDED_OCR_MAX_IMAGES_PER_DOCUMENT=25
EMBEDDED_OCR_MAX_IMAGES_PER_PAGE=5
EMBEDDED_OCR_MAX_PIXELS=16000000
EMBEDDED_OCR_MAX_DECODED_BYTES=20000000

[ingestion]
INGESTION_MAX_ATTEMPTS=5
INGESTION_LOCK_SECONDS=300
INGESTION_POLL_SECONDS=1
INGESTION_BACKOFF_BASE_SECONDS=2
INGESTION_BACKOFF_MAX_SECONDS=3600
INGESTION_PIPELINE_VERSION=v1

[vector_store]
VECTOR_STORE=qdrant_local
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_ROLLBACK_DUAL_WRITE=true
QDRANT_MODE=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_PREFER_GRPC=false
QDRANT_PATH=
QDRANT_LOCAL_PATH=db/qdrant_data
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MODEL_LOAD_TIMEOUT_SECONDS=60
EMBEDDING_MODEL_VERSION=all-MiniLM-L6-v2

[rag]
CHAT_FOLLOW_UP_CONTEXT_MINUTES=30
RAG_RETRIEVAL_LIMIT=15
RAG_FINAL_CONTEXT_LIMIT=5
RAG_FINAL_CONTEXT_TOKEN_BUDGET=6000
RAG_COMPLEMENTARY_CONTEXT_LIMIT=3
RAG_COMPLEMENTARY_MIN_SCORE=0.15
RAG_NEIGHBOR_EXPANSION_MIN_SCORE=0.50
RAG_NEIGHBOR_EXPANSION_MAX_NEIGHBORS=2
RAG_MIN_SCORE=0.30
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_CANDIDATE_LIMIT=30
RAG_KEYWORD_CANDIDATE_LIMIT=30
RAG_RRF_K=60
RAG_STRUCTURED_RESULT_LIMIT=100
RAG_DIAGNOSTICS_ENABLED=false

[opensearch]
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=rag_chunks

[maintenance]
HARD_DELETE_ENABLED=false
